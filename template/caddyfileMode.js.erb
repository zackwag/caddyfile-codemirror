const MATCHERS = new Set(<%= vocab[:matchers].to_json %>);
const CONSTANTS = new Set(<%= vocab[:constants].to_json %>);
const VALUES = new Set(<%= vocab[:values].to_json %>);

const ENV_VAR = /^\{\$[^\s{}"`]+\}/;
const PLACEHOLDER = /^\{[A-Za-z_%?][^\s{}"`]*\}/;
const OPEN_BLOCK = /^\{[ \t]*(?:#.*)?$/;
