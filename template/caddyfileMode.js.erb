function classifyMatcherWord(word) {
    if (word === "not") return { style: "keyword", mode: "margs" };
    if (MATCHERS.has(word)) return { style: "builtin", mode: "margs" };
    if (SUBDIRECTIVES.has(word)) return { style: "property", mode: "margs" };
